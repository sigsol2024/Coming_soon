# Single public homepage entry.
DirectoryIndex index.php

# Old bookmark /index.html → homepage. Block raw template access.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^home\.html$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "(?i)^index\.php$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header unset ETag
  </FilesMatch>

  <FilesMatch "(?i)^contact\.php$">
    Header set Cache-Control "no-cache"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Fingerprinted/versioned static assets: long-term cache is safe.
  <FilesMatch "(?i)\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

FileETag None

# The preview router does not apply on InfinityFree. Apache has to refuse these itself.
<FilesMatch "(?i)\.(sqlite|sqlite3)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
<FilesMatch "(?i)^(config|version)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
